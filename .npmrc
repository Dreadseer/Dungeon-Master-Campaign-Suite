# react-konva@18.2.10 declares a peer range of konva ^7/^8/^9, but this project
# runs konva ^10. The installed tree (konva 10.3.0 + react-konva 18.2.10) works,
# but npm's strict peer resolver refuses to build it from scratch, so a clean
# `npm install` fails with ERESOLVE without this flag.
#
# See docs/BUILD_STATUS.md (Phase 0, open questions) — the real fix is to either
# align konva to ^9 or move to a react-konva release that accepts ^10. Both are
# runtime-dependency changes and out of scope for Phase 0.
legacy-peer-deps=true
